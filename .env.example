# CryptoTrace Environment Configuration Template
# Copy to .env for local configuration. NEVER commit .env to version control.

# Application Environment (development / production)
APP_ENV=development

# Server Binding
PORT=8000
HOST=0.0.0.0

# Security (Required in production)
API_AUTH_TOKEN=

# Database
DB_PATH=investigations.db

# Blockchain Provider APIs (Optional for synthetic demo; required for live chain queries)
TRONGRID_API_KEY=
ETH_RPC_URL=https://eth.llamarpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Intelligence & Policies
VASP_REGISTRY_PATH=backend/vasp/data/vasp_labels.json
VASP_STALE_DAYS=180
CASE_MONITOR_INTERVAL_SECONDS=60
